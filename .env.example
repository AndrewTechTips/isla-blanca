# Copy to .env and adjust. Used by docker-compose and by the backend.
# Values below are for local development only.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=isla
POSTGRES_PASSWORD=isla_dev_password
POSTGRES_DB=isla_blanca
POSTGRES_PORT=5433

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://isla:isla_dev_password@localhost:5433/isla_blanca
TEST_DATABASE_URL=postgresql+psycopg://isla:isla_dev_password@localhost:5433/isla_blanca_test
CORS_ORIGINS=["http://localhost:5173"]

# --- Authentication (JWT) ---
# Generate your own: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Demo accounts created by the seed script (local only) ---
SEED_ADMIN_EMAIL=admin@islablanca.test
SEED_ADMIN_PASSWORD=Admin-IslaBlanca-2026
SEED_GUEST_PASSWORD=Guest-IslaBlanca-2026
